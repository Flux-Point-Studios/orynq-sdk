; Orynq credential broker: the draft that mandate.prepare takes (spec §3.3), normative CDDL.
;
; A draft carries the conduct mandate-v1 terms the principal chooses
; (packages/conduct/docs/mandate-v1.cddl). The broker fills mandate_id (16 random bytes) and
; agent_did (its instance key), fixes schema_version 1, did_format_version 0 and egress_policy
; {mode 0, zero root} (egress stays with W), and derives counterparty_allowlist_root from
; `members`. Signing surfaces recompute every member and the root before they display anything.
;
; Wire form, method rules and the files read with this one: see params.cddl.

mandate-draft = {
  principalDid: did-key,
  domain: executor-domain,
  ? supersedes: commitment,           ; the mandate this one widens or narrows (§3.4)
  spendCap: spend-cap,
  members: [1*256 member],            ; the counterparty allowlist (D = 8)
  approvedMeasurementSetRoot: digest, ; reviewed X builds (§3.1)
  validityWindow: validity-window,
  disclosurePolicy: disclosure-policy,
}

; As in mandate-v1: did:key, base58btc multibase, of a pinned authenticator credential.
did-key = text .regexp "did:key:z[1-9A-HJ-NP-Za-km-z]{8,256}"

; X:<brokerId> or committee:<rosterId>, each id 32 bytes in lowercase hex (§3.1, §6.3).
executor-domain = text .regexp "(X|committee):[0-9a-f]{64}"

spend-cap = {
  asset: broker-asset,
  amount: uint .ge 1,                 ; per tumbling window, in the asset's base unit
  windowSeconds: uint .ge 1,
}

; Lovelace, Midnight DUST in SPECK, or one unit per call (§3.1).
broker-asset = "lovelace" / "midnight:dust" / "orynq:call"

validity-window = {
  notBefore: uint,                    ; unix seconds, inclusive
  notAfter: uint,                     ; unix seconds, exclusive; the tier bounds the span
}

disclosure-policy = {
  committeeId: text .size (1..128),
  threshold: uint .ge 1,
  committeeSize: uint .ge 1,          ; at least threshold
}

; An allowlist member as mandate.register also carries it (§3.3). A capability's oc1 string
; hashes its kind, alias and rule digest (§3.2); a Cardano counterparty's ca1 string hashes its
; network and credentials.
member = { cap: capability } / { ca1: cardano-counterparty }

capability = {
  kind: capability-kind,
  alias: alias-name,
  ruleDigest: digest,                 ; SHA-256(dCBOR(rule))
}

cardano-counterparty = {
  networkId: uint .le 15,
  paymentCred: bytes .size 28,
  ? stakeCred: bytes .size 28,
}

; An effect kind such as http.request, or a fee kind such as cardano.fee.
capability-kind = text .regexp "[a-z][a-zA-Z0-9]{0,31}(\\.[a-z][a-zA-Z0-9]{0,31}){1,3}"

; A test: alias is one the broker serves while an install gate fails (§5.1).
alias-name = text .regexp "(test:)?[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?"

digest = bytes .size 32
commitment = bytes .size 32           ; C = SHA-256("orynq:conduct:mandate:v1|" || mandate CBOR)
