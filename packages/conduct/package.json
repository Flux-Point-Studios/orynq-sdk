{
  "name": "@fluxpointstudios/orynq-sdk-conduct",
  "version": "0.1.0",
  "description": "Canonical agent mandates, predicate compilation and runtime conduct guards",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run tests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "orynq",
    "conduct",
    "mandate",
    "guard"
  ],
  "author": "Flux Point Studios",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Flux-Point-Studios/orynq-sdk",
    "directory": "packages/conduct"
  },
  "homepage": "https://github.com/Flux-Point-Studios/orynq-sdk#readme",
  "bugs": "https://github.com/Flux-Point-Studios/orynq-sdk/issues",
  "dependencies": {
    "@fluxpointstudios/orynq-sdk-process-trace": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "tsup": "^8.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false
}
