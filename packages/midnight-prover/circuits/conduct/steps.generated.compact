export circuit st_ea(s: ConductStep): [] {
  const destination = st_ea_destination();
  const ts = st_ea_ts();
  const actionDigest = st_ea_actionDigest();
  const enforcedAt = st_ea_enforcedAt();
  const mandateCommitment = st_ea_mandateCommitment();
  const dataSeq = st_ea_dataSeq();
  const id = st_ea_id();
  const traceSeq = st_ea_traceSeq();
  const iso = st_ea_iso();
  const vis = st_ea_vis();
  const eventHash = persistentHash<[Bytes<53>, Vector<4, Uint<8>>, Bytes<31>, Vector<1, Uint<8>>, Bytes<19>, Vector<64, Uint<8>>, Bytes<38>, Vector<1, Uint<8>>, Bytes<23>, Vector<64, Uint<8>>, Bytes<9>, Vector<1, Uint<8>>, Bytes<15>, Vector<1, Uint<8>>, Bytes<85>, Vector<36, Uint<8>>, Bytes<24>, Vector<1, Uint<8>>, Bytes<14>, Vector<24, Uint<8>>, Bytes<16>, Vector<7, Uint<8>>, Bytes<2>]>(["poi-trace:event:v1|{\"data\":{\"action\":{\"destination\":\"", destination, "\",\"kind\":\"egress\",\"timestamp\":\"", ts, "\"},\"actionDigest\":\"", actionDigest, "\",\"actionKind\":\"egress\",\"enforcedAt\":\"", enforcedAt, "\",\"mandateCommitment\":\"", mandateCommitment, "\",\"seq\":\"", dataSeq, "\",\"timestamp\":\"", ts, "\",\"type\":\"orynq.conduct.guard.action.v1\"},\"eventType\":\"orynq.conduct.guard.v1\",\"id\":\"", id, "\",\"kind\":\"custom\",\"seq\":", traceSeq, ",\"timestamp\":\"", iso, "\",\"visibility\":\"", vis, "\"}"]);
  const eventHex = st_ea_eventHex();
  hexOfHash(eventHex, eventHash);
  assert(persistentHash<[Bytes<18>, Bytes<64>, Bytes<1>, Vector<64, Uint<8>>]>(["poi-trace:roll:v1|", s.prevRollHex, "|", eventHex]) == s.rollAfter, "rolling root mismatch");
  const tsValue = decU64<1>(ts);
  const enforcedAtValue = decU64<1>(enforcedAt);
  assert(decU64<1>(dataSeq) == s.dataSeq, "dataSeq opening");
  assert(dec53<1>(traceSeq) == s.traceSeq, "traceSeq opening");
  jsonStr<4>(destination);
  uuid(id);
  iso8601(iso);
  vis7(vis);
  assert(tsValue <= 23, "action cbor head");
  hexOfHash(actionDigest, persistentHash<[Bytes<30>, Vector<2, Uint<8>>, Bytes<7>, Vector<1, Uint<8>>, Bytes<1>, Vector<4, Uint<8>>, Vector<1, Uint<8>>, Uint<8>]>(["orynq:conduct:guard:action:v1|", [163, 0], "fegress", [1], "d", destination, [2], tsValue as Uint<8>]));
  const commitment = st_ea_commitment();
  hexOfBytes(mandateCommitment, commitment);
  const atoms = st_ea_atoms();
  assert(persistentHash<[Bytes<32>, Vector<32, Uint<8>>, Uint<64>, Uint<64>, Bytes<32>, Uint<64>, Uint<64>, Uint<8>, Bytes<32>, Bytes<32>]>([pad(32, "orynq:conduct:mandate-atoms:v1"), commitment, atoms.notBefore, atoms.notAfter, atoms.assetDigest, atoms.capAmount, atoms.windowSeconds, atoms.egressMode, atoms.counterpartyRoot, atoms.egressRoot]) == s.atoms, "mandate atoms mismatch");
  const window = st_ea_window();
  windowOf(tsValue, enforcedAtValue, atoms.windowSeconds, window.q, window.r, window.rClock);
  assert(window.q == s.windowIndex, "window index");
  const path = st_ea_path();
  const memberOk = allowlistRoot<2>(persistentHash<[Bytes<33>, Vector<4, Uint<8>>]>(["orynq:conduct:allowlist:leaf:v1|d", destination]), path) == atoms.egressRoot;
  const verdict = CV_decide(enforcedAtValue, atoms.notBefore, atoms.notAfter, atoms.capAmount, atoms.egressMode, 1, tsValue, 0, false, false, s.priorSpent, memberOk);
  assert(verdict != 5 && verdict != 7, "non-membership not provable");
  assert(verdict == s.verdict, "verdict mismatch");
  assert(verdict == 0, "recorded decision");
  conductStep = disclose(s);
}

