  const tsValue = decU64<1>(ts);
  const enforcedAtValue = decU64<1>(enforcedAt);
  assert(decU64<1>(dataSeq) == s.dataSeq, "dataSeq opening");
  assert(dec53<1>(traceSeq) == s.traceSeq, "traceSeq opening");
  jsonStr<3>(asset);
  jsonStr<4>(counterparty);
  uuid(id);
  iso8601(iso);
  vis7(vis);
  assert(amountValue <= 23, "action cbor head");
  assert(tsValue <= 23, "action cbor head");
  hexOfHash(actionDigest, persistentHash<[Bytes<30>, Vector<2, Uint<8>>, Bytes<8>, Vector<1, Uint<8>>, Bytes<1>, Vector<3, Uint<8>>, Vector<1, Uint<8>>, Uint<8>, Vector<1, Uint<8>>, Bytes<1>, Vector<4, Uint<8>>, Vector<1, Uint<8>>, Uint<8>]>(["orynq:conduct:guard:action:v1|", [165, 0], "gpayment", [1], "c", asset, [2], amountValue as Uint<8>, [3], "d", counterparty, [4], tsValue as Uint<8>]));
