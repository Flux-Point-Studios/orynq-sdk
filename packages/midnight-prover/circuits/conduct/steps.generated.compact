witness st_pa_max_d8_tsCbor(): Vector<8, Uint<8>>;
witness st_pa_max_d8_commitment(): Vector<32, Uint<8>>;
witness st_pa_max_d8_atoms(): MandateAtoms;
witness st_pa_max_d8_window(): WindowSplit;
witness st_pa_max_d8_path(): Vector<8, PathStep>;

export circuit st_pa_max_d8(s: ConductStep): [] {
  const amount = st_pa_max_d8_amount();
  const asset = st_pa_max_d8_asset();
  const counterparty = st_pa_max_d8_counterparty();
  const ts = st_pa_max_d8_ts();
  const actionDigest = st_pa_max_d8_actionDigest();
  const enforcedAt = st_pa_max_d8_enforcedAt();
  const mandateCommitment = st_pa_max_d8_mandateCommitment();
  const dataSeq = st_pa_max_d8_dataSeq();
  const id = st_pa_max_d8_id();
  const traceSeq = st_pa_max_d8_traceSeq();
  const iso = st_pa_max_d8_iso();
  const vis = st_pa_max_d8_vis();
  const eventHash = persistentHash<[Bytes<48>, Vector<20, Uint<8>>, Bytes<11>, Vector<128, Uint<8>>, Bytes<18>, Vector<256, Uint<8>>, Bytes<32>, Vector<20, Uint<8>>, Bytes<19>, Vector<64, Uint<8>>, Bytes<39>, Vector<20, Uint<8>>, Bytes<23>, Vector<64, Uint<8>>, Bytes<9>, Vector<20, Uint<8>>, Bytes<15>, Vector<20, Uint<8>>, Bytes<85>, Vector<36, Uint<8>>, Bytes<24>, Vector<16, Uint<8>>, Bytes<14>, Vector<24, Uint<8>>, Bytes<16>, Vector<7, Uint<8>>, Bytes<2>]>(["poi-trace:event:v1|{\"data\":{\"action\":{\"amount\":\"", amount, "\",\"asset\":\"", asset, "\",\"counterparty\":\"", counterparty, "\",\"kind\":\"payment\",\"timestamp\":\"", ts, "\"},\"actionDigest\":\"", actionDigest, "\",\"actionKind\":\"payment\",\"enforcedAt\":\"", enforcedAt, "\",\"mandateCommitment\":\"", mandateCommitment, "\",\"seq\":\"", dataSeq, "\",\"timestamp\":\"", ts, "\",\"type\":\"orynq.conduct.guard.action.v1\"},\"eventType\":\"orynq.conduct.guard.v1\",\"id\":\"", id, "\",\"kind\":\"custom\",\"seq\":", traceSeq, ",\"timestamp\":\"", iso, "\",\"visibility\":\"", vis, "\"}"]);
  const eventHex = st_pa_max_d8_eventHex();
  hexOfHash(eventHex, eventHash);
  assert(persistentHash<[Bytes<18>, Bytes<64>, Bytes<1>, Vector<64, Uint<8>>]>(["poi-trace:roll:v1|", s.prevRollHex, "|", eventHex]) == s.rollAfter, "rolling root mismatch");
  const amountValue = decU64<20>(amount);
  assert(amountValue != 0, "decimal nonzero");
  const tsValue = decU64<20>(ts);
  const enforcedAtValue = decU64<20>(enforcedAt);
  assert(decU64<20>(dataSeq) == s.dataSeq, "dataSeq opening");
  assert(dec53<16>(traceSeq) == s.traceSeq, "traceSeq opening");
  jsonStr<128>(asset);
  jsonStr<256>(counterparty);
  uuid(id);
  iso8601(iso);
  vis7(vis);
  const amountCbor = st_pa_max_d8_amountCbor();
  assert(cborUint<8>(amountCbor) == amountValue, "action cbor uint");
  const tsCbor = st_pa_max_d8_tsCbor();
  assert(cborUint<8>(tsCbor) == tsValue, "action cbor uint");
  hexOfHash(actionDigest, persistentHash<[Bytes<30>, Vector<2, Uint<8>>, Bytes<8>, Vector<1, Uint<8>>, Bytes<1>, Vector<1, Uint<8>>, Vector<128, Uint<8>>, Vector<2, Uint<8>>, Vector<8, Uint<8>>, Vector<1, Uint<8>>, Bytes<1>, Vector<2, Uint<8>>, Vector<256, Uint<8>>, Vector<2, Uint<8>>, Vector<8, Uint<8>>]>(["orynq:conduct:guard:action:v1|", [165, 0], "gpayment", [1], "x", [128], asset, [2, 27], amountCbor, [3], "y", [1, 0], counterparty, [4, 27], tsCbor]));
  const commitment = st_pa_max_d8_commitment();
  hexOfBytes(mandateCommitment, commitment);
  const atoms = st_pa_max_d8_atoms();
  assert(persistentHash<[Bytes<32>, Vector<32, Uint<8>>, Uint<64>, Uint<64>, Bytes<32>, Uint<64>, Uint<64>, Uint<8>, Bytes<32>, Bytes<32>]>([pad(32, "orynq:conduct:mandate-atoms:v1"), commitment, atoms.notBefore, atoms.notAfter, atoms.assetDigest, atoms.capAmount, atoms.windowSeconds, atoms.egressMode, atoms.counterpartyRoot, atoms.egressRoot]) == s.atoms, "mandate atoms mismatch");
  const window = st_pa_max_d8_window();
  windowOf(tsValue, enforcedAtValue, atoms.windowSeconds, window.q, window.r, window.rClock);
  assert(window.q == s.windowIndex, "window index");
  const assetOk = persistentHash<[Vector<128, Uint<8>>]>([asset]) == atoms.assetDigest;
  const path = st_pa_max_d8_path();
  const memberOk = allowlistRoot<8>(persistentHash<[Bytes<33>, Vector<2, Uint<8>>, Vector<256, Uint<8>>]>(["orynq:conduct:allowlist:leaf:v1|y", [1, 0], counterparty]), path) == atoms.counterpartyRoot;
  const verdict = CV_decide(enforcedAtValue, atoms.notBefore, atoms.notAfter, atoms.capAmount, atoms.egressMode, 0, tsValue, amountValue, assetOk, memberOk, s.priorSpent, false);
  assert(verdict != 5 && verdict != 7, "non-membership not provable");
  assert(verdict == s.verdict, "verdict mismatch");
  assert(verdict == 0, "recorded decision");
  conductStep = disclose(s);
}

export pure circuit allowlist_root_d1(leaf: Bytes<32>, path: Vector<1, PathStep>): Bytes<32> {
  return allowlistRoot<1>(leaf, path);
}

export pure circuit allowlist_root_d2(leaf: Bytes<32>, path: Vector<2, PathStep>): Bytes<32> {
  return allowlistRoot<2>(leaf, path);
}

export pure circuit allowlist_root_d3(leaf: Bytes<32>, path: Vector<3, PathStep>): Bytes<32> {
  return allowlistRoot<3>(leaf, path);
}

export pure circuit allowlist_root_d4(leaf: Bytes<32>, path: Vector<4, PathStep>): Bytes<32> {
  return allowlistRoot<4>(leaf, path);
}

export pure circuit allowlist_root_d5(leaf: Bytes<32>, path: Vector<5, PathStep>): Bytes<32> {
  return allowlistRoot<5>(leaf, path);
}

export pure circuit allowlist_root_d6(leaf: Bytes<32>, path: Vector<6, PathStep>): Bytes<32> {
  return allowlistRoot<6>(leaf, path);
}

export pure circuit window_split(ts: Uint<64>, clock: Uint<64>, w: Uint<64>, q: Uint<64>, r: Uint<64>, rClock: Uint<64>): [] {
  return windowOf(ts, clock, w, q, r, rClock);
}

export pure circuit hex_of_bytes(v: Vector<64, Uint<8>>, b: Vector<32, Uint<8>>): [] {
  return hexOfBytes(v, b);
}
