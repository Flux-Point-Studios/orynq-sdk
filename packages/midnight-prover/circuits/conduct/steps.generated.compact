  const id = st_pd4_id();
  const traceSeq = st_pd4_traceSeq();
  const iso = st_pd4_iso();
  const vis = st_pd4_vis();
  const eventHash = persistentHash<[Bytes<48>, Vector<1, Uint<8>>, Bytes<11>, Vector<3, Uint<8>>, Bytes<18>, Vector<4, Uint<8>>, Bytes<32>, Vector<1, Uint<8>>, Bytes<19>, Vector<64, Uint<8>>, Bytes<39>, Vector<1, Uint<8>>, Bytes<23>, Vector<64, Uint<8>>, Bytes<95>, Vector<1, Uint<8>>, Bytes<15>, Vector<1, Uint<8>>, Bytes<85>, Vector<36, Uint<8>>, Bytes<24>, Vector<1, Uint<8>>, Bytes<14>, Vector<24, Uint<8>>, Bytes<16>, Vector<7, Uint<8>>, Bytes<2>]>(["poi-trace:event:v1|{\"data\":{\"action\":{\"amount\":\"", amount, "\",\"asset\":\"", asset, "\",\"counterparty\":\"", counterparty, "\",\"kind\":\"payment\",\"timestamp\":\"", ts, "\"},\"actionDigest\":\"", actionDigest, "\",\"actionKind\":\"payment\",\"enforcedAt\":\"", enforcedAt, "\",\"mandateCommitment\":\"", mandateCommitment, "\",\"reason\":\"SPEND_CAP_EXCEEDED\",\"rule\":\"payment exceeds the remaining window spend cap\",\"seq\":\"", dataSeq, "\",\"timestamp\":\"", ts, "\",\"type\":\"orynq.conduct.guard.denial.v1\"},\"eventType\":\"orynq.conduct.guard.v1\",\"id\":\"", id, "\",\"kind\":\"custom\",\"seq\":", traceSeq, ",\"timestamp\":\"", iso, "\",\"visibility\":\"", vis, "\"}"]);
  const eventHex = st_pd4_eventHex();
  hexOfHash(eventHex, eventHash);
  assert(persistentHash<[Bytes<18>, Bytes<64>, Bytes<1>, Vector<64, Uint<8>>]>(["poi-trace:roll:v1|", s.prevRollHex, "|", eventHex]) == s.rollAfter, "rolling root mismatch");
  const amountValue = decU64<1>(amount);
  assert(amountValue != 0, "decimal nonzero");
  const tsValue = decU64<1>(ts);
  const enforcedAtValue = decU64<1>(enforcedAt);
  assert(decU64<1>(dataSeq) == s.dataSeq, "dataSeq opening");
  assert(dec53<1>(traceSeq) == s.traceSeq, "traceSeq opening");
  jsonStr<3>(asset);
  jsonStr<4>(counterparty);
  uuid(id);
  iso8601(iso);
  vis7(vis);
  assert(amountValue <= 23, "action cbor head");
  assert(tsValue <= 23, "action cbor head");
  hexOfHash(actionDigest, persistentHash<[Bytes<30>, Vector<2, Uint<8>>, Bytes<8>, Vector<1, Uint<8>>, Bytes<1>, Vector<3, Uint<8>>, Vector<1, Uint<8>>, Uint<8>, Vector<1, Uint<8>>, Bytes<1>, Vector<4, Uint<8>>, Vector<1, Uint<8>>, Uint<8>]>(["orynq:conduct:guard:action:v1|", [165, 0], "gpayment", [1], "c", asset, [2], amountValue as Uint<8>, [3], "d", counterparty, [4], tsValue as Uint<8>]));
  const commitment = st_pd4_commitment();
  hexOfBytes(mandateCommitment, commitment);
  const atoms = st_pd4_atoms();
  assert(persistentHash<[Bytes<32>, Vector<32, Uint<8>>, Uint<64>, Uint<64>, Bytes<32>, Uint<64>, Uint<64>, Uint<8>, Bytes<32>, Bytes<32>]>([pad(32, "orynq:conduct:mandate-atoms:v1"), commitment, atoms.notBefore, atoms.notAfter, atoms.assetDigest, atoms.capAmount, atoms.windowSeconds, atoms.egressMode, atoms.counterpartyRoot, atoms.egressRoot]) == s.atoms, "mandate atoms mismatch");
  const window = st_pd4_window();
  windowOf(tsValue, enforcedAtValue, atoms.windowSeconds, window.q, window.r, window.rClock);
  assert(window.q == s.windowIndex, "window index");
  const assetOk = persistentHash<[Vector<3, Uint<8>>]>([asset]) == atoms.assetDigest;
  const path = st_pd4_path();
  const memberOk = allowlistRoot<2>(persistentHash<[Bytes<33>, Vector<4, Uint<8>>]>(["orynq:conduct:allowlist:leaf:v1|d", counterparty]), path) == atoms.counterpartyRoot;
  const verdict = CV_decide(enforcedAtValue, atoms.notBefore, atoms.notAfter, atoms.capAmount, atoms.egressMode, 0, tsValue, amountValue, assetOk, memberOk, s.priorSpent, false);
  assert(verdict != 5 && verdict != 7, "non-membership not provable");
  assert(verdict == s.verdict, "verdict mismatch");
  assert(verdict == 4, "recorded decision");
  conductStep = disclose(s);
}

