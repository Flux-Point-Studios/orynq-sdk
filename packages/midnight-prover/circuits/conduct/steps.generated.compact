  assert(window.q == s.windowIndex, "window index");
  const assetOk = persistentHash<[Vector<3, Uint<8>>]>([asset]) == atoms.assetDigest;
  const path = st_pa_path();
  const memberOk = allowlistRoot<2>(persistentHash<[Bytes<33>, Vector<4, Uint<8>>]>(["orynq:conduct:allowlist:leaf:v1|d", counterparty]), path) == atoms.counterpartyRoot;
