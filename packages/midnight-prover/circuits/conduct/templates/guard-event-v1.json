{
  "version": 1,
  "domain": "poi-trace:event:v1|",
  "actions": {
    "payment": [
      { "c": "poi-trace:event:v1|{\"data\":{\"action\":{\"amount\":\"" },
      { "v": "amount", "lex": "dec64", "max": 20, "nonzero": true },
      { "c": "\",\"asset\":\"" },
      { "v": "asset", "lex": "str", "max": 128 },
      { "c": "\",\"counterparty\":\"" },
      { "v": "counterparty", "lex": "str", "max": 256 },
      { "c": "\",\"kind\":\"payment\",\"timestamp\":\"" },
      { "v": "ts", "lex": "dec64", "max": 20 },
      { "c": "\"},\"actionDigest\":\"" },
      { "v": "actionDigest", "lex": "hex64" },
      { "c": "\",\"actionKind\":\"payment\",\"enforcedAt\":\"" },
      { "v": "enforcedAt", "lex": "dec64", "max": 20 },
      { "c": "\",\"mandateCommitment\":\"" },
      { "v": "mandateCommitment", "lex": "hex64" },
      { "c": "\",\"seq\":\"" },
      { "v": "dataSeq", "lex": "dec64", "max": 20 },
      { "c": "\",\"timestamp\":\"" },
      { "v": "ts", "lex": "dec64", "max": 20 },
      { "c": "\",\"type\":\"orynq.conduct.guard.action.v1\"},\"eventType\":\"orynq.conduct.guard.v1\",\"id\":\"" },
      { "v": "id", "lex": "uuid" },
      { "c": "\",\"kind\":\"custom\",\"seq\":" },
      { "v": "traceSeq", "lex": "dec53", "max": 16 },
      { "c": ",\"timestamp\":\"" },
      { "v": "iso", "lex": "iso24" },
      { "c": "\",\"visibility\":\"" },
      { "v": "vis", "lex": "vis" },
      { "c": "\"}" }
    ],
    "egress": [
      { "c": "poi-trace:event:v1|{\"data\":{\"action\":{\"destination\":\"" },
      { "v": "destination", "lex": "str", "max": 256 },
      { "c": "\",\"kind\":\"egress\",\"timestamp\":\"" },
      { "v": "ts", "lex": "dec64", "max": 20 },
      { "c": "\"},\"actionDigest\":\"" },
      { "v": "actionDigest", "lex": "hex64" },
      { "c": "\",\"actionKind\":\"egress\",\"enforcedAt\":\"" },
      { "v": "enforcedAt", "lex": "dec64", "max": 20 },
      { "c": "\",\"mandateCommitment\":\"" },
      { "v": "mandateCommitment", "lex": "hex64" },
      { "c": "\",\"seq\":\"" },
      { "v": "dataSeq", "lex": "dec64", "max": 20 },
      { "c": "\",\"timestamp\":\"" },
      { "v": "ts", "lex": "dec64", "max": 20 },
      { "c": "\",\"type\":\"orynq.conduct.guard.action.v1\"},\"eventType\":\"orynq.conduct.guard.v1\",\"id\":\"" },
      { "v": "id", "lex": "uuid" },
      { "c": "\",\"kind\":\"custom\",\"seq\":" },
      { "v": "traceSeq", "lex": "dec53", "max": 16 },
      { "c": ",\"timestamp\":\"" },
      { "v": "iso", "lex": "iso24" },
      { "c": "\",\"visibility\":\"" },
      { "v": "vis", "lex": "vis" },
      { "c": "\"}" }
    ]
  },
  "types": { "event": "orynq.conduct.guard.v1", "action": "orynq.conduct.guard.action.v1", "denial": "orynq.conduct.guard.denial.v1" },
  "denial": {
    "insertAfter": "mandateCommitment",
    "insert": "\",\"reason\":\"{reason}\",\"rule\":\"{rule}"
  },
  "reasons": {
    "MANDATE_NOT_YET_VALID": { "code": 1, "rule": "timestamp precedes mandate validity", "actions": ["payment", "egress"] },
    "MANDATE_EXPIRED": { "code": 2, "rule": "timestamp reaches or exceeds mandate expiry", "actions": ["payment", "egress"] },
    "ASSET_MISMATCH": { "code": 3, "rule": "asset is not the mandated asset", "actions": ["payment"] },
    "SPEND_CAP_EXCEEDED": { "code": 4, "rule": "payment exceeds the remaining window spend cap", "actions": ["payment"] },
    "COUNTERPARTY_NOT_ALLOWED": { "code": 5, "rule": "counterparty is not in the mandate allowlist", "actions": ["payment"] },
    "EGRESS_DENIED": { "code": 6, "rule": "mandate egress policy is deny-all", "actions": ["egress"] },
    "EGRESS_NOT_ALLOWED": { "code": 7, "rule": "destination is not in the egress allowlist", "actions": ["egress"] }
  }
}
