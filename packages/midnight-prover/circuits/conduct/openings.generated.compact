  const threshold = m_step_threshold();
  const committeeSize = m_step_committeeSize();
  const commitment = persistentHash<[Bytes<25>, Vector<4, Uint<8>>, Bytes<1>, Vector<16, Uint<8>>, Vector<1, Uint<8>>, Bytes<10>, Vector<8, Uint<8>>, Vector<1, Uint<8>>, Bytes<10>, Vector<8, Uint<8>>, Vector<5, Uint<8>>, Bytes<1>, Vector<3, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Bytes<2>, Vector<32, Uint<8>>, Vector<3, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Bytes<2>, Vector<32, Uint<8>>, Vector<1, Uint<8>>, Bytes<2>, Vector<32, Uint<8>>, Vector<3, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Vector<3, Uint<8>>, Bytes<1>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>, Vector<1, Uint<8>>]>(["orynq:conduct:mandate:v1|", [171, 0, 1, 1], "P", mandateId, [2], "qdid:key:z", principalDid, [3], "qdid:key:z", agentDid, [4, 0, 5, 163, 0], "c", asset, [1], capAmount, [2], windowSeconds, [6], "X ", counterpartyRoot, [7, 162, 0], egressMode, [1], "X ", egressRoot, [8], "X ", measurementRoot, [9, 162, 0], notBefore, [1], notAfter, [10, 163, 0], "a", committeeId, [1], threshold, [2], committeeSize]);
  assert(commitment == s.commitment, "mandate commitment opening");
  const capAmountValue = cborHeadValue(capAmount[0]);
  const windowSecondsValue = cborHeadValue(windowSeconds[0]);
  const notBeforeValue = cborHeadValue(notBefore[0]);
  const notAfterValue = cborHeadValue(notAfter[0]);
  const thresholdValue = cborHeadValue(threshold[0]);
  const committeeSizeValue = cborHeadValue(committeeSize[0]);
  assert(persistentHash<[Bytes<32>, Bytes<32>, Uint<64>, Uint<64>, Bytes<32>, Uint<64>, Uint<64>, Uint<8>, Vector<32, Uint<8>>, Vector<32, Uint<8>>]>([pad(32, "orynq:conduct:mandate-atoms:v1"), commitment, notBeforeValue, notAfterValue, persistentHash<[Vector<3, Uint<8>>]>([asset]), capAmountValue, windowSecondsValue, egressMode[0], counterpartyRoot, egressRoot]) == s.atoms, "mandate atoms opening");
  base58<8>(principalDid);
  base58<8>(agentDid);
  asciiPrint<3>(asset);
  assert(windowSecondsValue >= 1, "mandate window");
  assert(egressMode[0] <= 1, "egress mode");
  for (const b of egressRoot) {
    assert(egressMode[0] == 1 || b == 0, "deny-all egress root");
  }
  assert(notBeforeValue < notAfterValue, "mandate validity window");
  utf8Any<1>(committeeId);
  assert(thresholdValue >= 1 && thresholdValue <= committeeSizeValue, "mandate disclosure threshold");
  mandateOpening = disclose(s);
}

export pure circuit cbor_uint_w0(head: Uint<8>): Uint<64> {
  return cborHeadValue(head);
}

