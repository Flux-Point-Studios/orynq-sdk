{
  "name": "@fluxpointstudios/orynq-sdk-midnight-prover",
  "version": "0.2.0",
  "description": "ZK proof generation for PoI using Midnight network",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tests",
    ".eslintrc.cjs",
    "circuits",
    "managed",
    "scripts",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "native/tests",
    "native/README.md",
    "artifact-pins.json",
    "native/SECURITY.md",
    "native/check-verify-only-boundary.sh",
    "native/public-input-boundary.sha256"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "build:circuits": "node scripts/compile-circuits.mjs",
    "build:native": "cargo build --release --locked --manifest-path native/Cargo.toml",
    "test:real": "tsx tests/real-proofs.integration.ts",
    "verify:artifacts": "node scripts/check-artifact-pins.mjs"
  },
  "dependencies": {
    "@fluxpointstudios/orynq-sdk-core": "workspace:*",
    "@fluxpointstudios/orynq-sdk-process-trace": "workspace:*",
    "@fluxpointstudios/orynq-sdk-anchors-cardano": "workspace:*",
    "@fluxpointstudios/orynq-sdk-attestor": "workspace:*",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.2",
    "@midnight-ntwrk/ledger-v8": "8.1.3",
    "@midnight-ntwrk/zkir-v2": "2.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "poi",
    "proof-of-inference",
    "midnight",
    "zk",
    "zero-knowledge",
    "privacy"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Flux Point Studios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Flux-Point-Studios/orynq-sdk.git",
    "directory": "packages/midnight-prover"
  }
}
